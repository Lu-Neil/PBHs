text.usetex        : False
font.family        : sans-serif
mathtext.fontset   : cm
lines.linewidth    : 1.4
font.size          : 14
xtick.labelsize    : medium
ytick.labelsize    : medium
xtick.direction    : in
ytick.direction    : in
axes.labelsize     : large
axes.titlesize     : large
axes.grid          : False
grid.alpha         : 0.73
lines.markersize   : 4
legend.borderpad   : 0.2
legend.fancybox    : True
legend.fontsize    : 12
legend.framealpha  : 0.7
legend.handletextpad : 0.5
legend.labelspacing : 0.2
legend.handlelength : 2
legend.loc         : best
savefig.dpi        : 600
pdf.compression    : 9
axes.prop_cycle: cycler("color", ["#D60606", "#0083DE", "#00BA75", "#FFC61E", "#A433B3", "#FD882E", "#6E6E6E"])
