@online{barnett2020,
  title = {Aliasing Error of the Exp\$(\textbackslash beta \textbackslash sqrt\{1-Z\textasciicircum 2\})\$ Kernel in the Nonuniform Fast {{Fourier}} Transform},
  author = {Barnett, A. H.}  date = {2020-10-13},
  eprint = {2001.09405},
  eprinttype = {arXiv},
