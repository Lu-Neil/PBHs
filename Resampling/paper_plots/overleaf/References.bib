  url = {https://doi.org/10.1038/253251a0},
  abstract = {ALTHOUGH only black holes with masses {$\greaterequivlnt$}; 1.5M{$\odot$} are expected to result from stellar evolution1 black holes with much smaller masses may be present throughout the Universe2. These small black holes are the result of density fluctuations in the very early Universe. Density fluctuations on very large mass scales were certainly present in the early universe as is evident from the irregular distribution of galaxies in the sky3. Evidence of density fluctuations on scales smaller than the size of galaxies is generally thought to have been destroyed during the era of radiation recombination4. But fluctuations in the metric of order unity may be fossilised in the form of black holes. Observation of black holes, particularly those with masses M {$<$} M{$\odot$}, could thus provide information concerning conditions in the very early Universe.}
}

