@article{morras2023,
  title = {Analysis of a Subsolar-Mass Compact Binary Candidate from the Second Observing Run of {{Advanced LIGO}}},
  author = {Morr\'as, Gonzalo and Nu\~no Siles, Jos\'e Francisco and Garc\'ia-Bellido, Juan and others}  date = {2023-12},
  journaltitle = {Physics of the Dark Universe},
  shortjournal = {Physics of the Dark Universe},
