\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  Speedup of using NUFFT compared to stroboscopic resampling for $f_0 = 20,\mathrm  {Hz}$, $M_c = 10^{-2} M_\odot $, $f_\mathrm  {sampling} = 512 \, \mathrm  {Hz}$ and $T_\text  {obs} = 32, 256, 2048 \,\mathrm  {s}$. The upsampling ratio is used by the stroboscopic resampling and the determines its accuracy, existing implementations of stroboscopic resampling often use upsampling ratios of $\approx 40$ for which substantial speedups could be achieved by using NUFFT. }}{5}{figure.caption.36}\protected@file@percent }
\newlabel{fig:NUFFT_speedup}{{4}{5}{Speedup of using NUFFT compared to stroboscopic resampling for $f_0 = 20,\mathrm {Hz}$, $M_c = 10^{-2} M_\odot $, $f_\mathrm {sampling} = 512 \, \mathrm {Hz}$ and $T_\text {obs} = 32, 256, 2048 \,\mathrm {s}$. The upsampling ratio is used by the stroboscopic resampling and the determines its accuracy, existing implementations of stroboscopic resampling often use upsampling ratios of $\approx 40$ for which substantial speedups could be achieved by using NUFFT}{figure.caption.36}{}}
